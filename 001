class Graph
{
    Dictionary<int, List<int>> d;

    public Graph()
    {
        d = new Dictionary<int, List<int>>();
    }

    public void AddVertex(int vertex)
    {
        if (!d.ContainsKey(vertex))
        {
            d[vertex] = new List<int>();
        }
    }

    public void Add(int v1, int v2)
    {
        AddVertex(v1);
        AddVertex(v2);

        d[v1].Add(v2);
        d[v2].Add(v1);
    }

    public void Print()
    {
        foreach (var vertex in d)
        {
            Console.Write("Вершина: " + vertex.Key);
            Console.WriteLine(vertex.Value);
        }
    }
}