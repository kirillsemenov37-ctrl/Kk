public interface INotificationService
{
    void Send(string recipient, string message);
}

public abstract class NotificationService : INotificationService
{
    protected void Log(string text)
    {
        Console.WriteLine(text);
    }

    public abstract void Send(string recipient, string message);
}

public class EmailNotificationService : NotificationService
{
    public override void Send(string email, string message)
    {
        Log($"Email sent to {email}: {message}");
    }
}

public class SmsNotificationService : NotificationService
{
    public override void Send(string phone, string message)
    {
        Log($"SMS sent to {phone}: {message}");
    }
}

public class PushNotificationService : NotificationService
{
    public override void Send(string deviceId, string message)
    {
        Log($"Push sent to {deviceId}: {message}");
    }
}